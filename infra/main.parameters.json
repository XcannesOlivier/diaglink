{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID}"
    },
    "serviceManagementReference": {
      "value": "${ENTRA_SERVICE_MANAGEMENT_REFERENCE=}"
    },
    "webImageName": {
      "value": "${SERVICE_WEB_IMAGE_NAME=}"
    },
    "aiAgentEndpoint": {
      "value": "${AI_AGENT_ENDPOINT=}"
    },
    "aiAgentId": {
      "value": "${AI_AGENT_ID=}"
    },
    "enableObo": {
      "value": "${ENABLE_OBO=false}"
    },
    "authOtpPepper": {
      "value": "${AUTH_OTP_PEPPER}"
    },
    "azureStorageConnectionString": {
      "value": "${AZURE_STORAGE_CONNECTION_STRING}"
    },
    "contactRecipientAddress": {
      "value": "${CONTACT_RECIPIENT_ADDRESS}"
    },
    "stripeSecretKey": {
      "value": "${STRIPE_SECRET_KEY}"
    },
    "customDomainName": {
      "value": "${CUSTOM_DOMAIN_NAME=app.diaglink.com}"
    },
    "customDomainCertificateName": {
      "value": "${CUSTOM_DOMAIN_CERTIFICATE_NAME=app.diaglink.com-cae-yhob-260911101349}"
    },
    "publicCustomDomainName": {
      "value": "${PUBLIC_CUSTOM_DOMAIN_NAME=diaglink.com}"
    },
    "publicCustomDomainCertificateName": {
      "value": "${PUBLIC_CUSTOM_DOMAIN_CERTIFICATE_NAME=}"
    }
  }
}
